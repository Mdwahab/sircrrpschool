# ==============================================================================
# SIR C. R. REDDY PUBLIC SCHOOL — ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env.local for local development.
# Configure these variables in Vercel Project Settings for production deployment.
# NEVER commit actual secrets or API keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE POSTGRESQL & AUTHENTICATION CONFIGURATION
# ------------------------------------------------------------------------------
# Your Supabase Project URL (found in Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://fgryltmfyswkziakuobz.supabase.co

# Supabase Publishable Key (safe for browser consumption with RLS)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_37SID9uhdt-bUvY1-2IRmA_HFudZKMp
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_37SID9uhdt-bUvY1-2IRmA_HFudZKMp

# Supabase Service Role / Secret Key (SERVER-ONLY — NEVER expose in NEXT_PUBLIC_ or client bundles)
# Used exclusively for privileged administrative migrations, seeds, and backend actions
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ------------------------------------------------------------------------------
# 2. TRANSACTIONAL EMAIL CONFIGURATION (RESEND)
# ------------------------------------------------------------------------------
# Resend API Key for sending automated admission enquiry email notifications
RESEND_API_KEY=re_your_api_key_here

# Verified sender email address (configured & domain-verified in Resend Dashboard)
RESEND_FROM_EMAIL="Sir C. R. Reddy Public School <notifications@yourverifieddomain.com>"

# Destination email where new parent enquiries are delivered
SCHOOL_ENQUIRY_NOTIFICATION_EMAIL=admissions@yourverifieddomain.com

# ------------------------------------------------------------------------------
# 3. VERIFIED SCHOOL CONTACT & APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------
# Base URL for metadata and Open Graph generation
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Verified school WhatsApp helpdesk number for click-to-chat (country code + 10 digits, e.g. +919440000000)
NEXT_PUBLIC_WHATSAPP_NUMBER=+919440000000
