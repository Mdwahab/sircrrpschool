# ==============================================================================
# SIR C. R. REDDY PUBLIC SCHOOL — ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env.local for local development.
# Configure these variables in Vercel Project Settings for production deployment.
# NEVER commit actual secrets or API keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE POSTGRESQL & AUTHENTICATION CONFIGURATION
# ------------------------------------------------------------------------------
# Your Supabase Project URL (found in Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anonymous Key (safe for browser consumption)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Key (SERVER-ONLY — NEVER expose in NEXT_PUBLIC_)
# Used exclusively for privileged administrative migrations and seed operations
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 2. TRANSACTIONAL EMAIL CONFIGURATION (RESEND)
# ------------------------------------------------------------------------------
# Resend API Key for sending automated admission enquiry email notifications
RESEND_API_KEY=re_your_api_key_here

# Verified sender email address (e.g. notifications@sircrrschool.ac.in)
RESEND_FROM_EMAIL="Sir C. R. Reddy Public School <onboarding@resend.dev>"

# Destination email where new parent enquiries are delivered
# Defaults to verified school office: sircrrps@yahoo.com
SCHOOL_ENQUIRY_NOTIFICATION_EMAIL=sircrrps@yahoo.com

# ------------------------------------------------------------------------------
# 3. VERIFIED SCHOOL CONTACT & APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------
# Base URL for metadata and Open Graph generation
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Verified school WhatsApp helpdesk number for click-to-chat (with country code)
# Replace placeholder with management-verified mobile SIM number
NEXT_PUBLIC_WHATSAPP_NUMBER=+919440000000
